# Prompt Palette Registry package exclusions (gitignore-style patterns).
# Ship runtime Python/JS/CSS, node_list.json, pyproject.toml, requirements.txt,
# README.md, LICENSE, STYLE_IMAGE_CREDITS.md and all bundled public assets.
# No blanket *.json, *.csv, *.txt, assets/ or web/ exclusions.
# This file controls comfy node pack/publish, not GitHub ZIP downloads.

# Repository metadata and CI (keep these tracked in Git)
.git/
.hg/
.svn/
/.github/
/.gitignore
/.gitattributes
/.comfyignore

# Development notes and root-level documentation; keep web/docs available
/docs/
AGENTS.md
AUDIT.md
RELEASE_NOTES.md
STYLE_LIBRARY_IMPLEMENTATION.md
*HANDOFF*.md
*Handoff*.md
*handoff*.md

# Tests, coverage and local QA
/tests/
/test/
/qa/
/audit-results/
/test-results/
__tests__/
__snapshots__/
test_*.py
*_test.py
*.test.js
*.spec.js
*.test.ts
*.spec.ts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage/
playwright-report/
.mypy_cache/
.pyright/
.ruff_cache/
.cache/

# Python environments, caches and build products
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version
/build/
/dist/
/downloads/
/eggs/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/wheels/
*.egg-info/
*.egg

# Frontend tooling; keep the shipped web/ runtime
node_modules/
npm-debug.log
yarn-debug.log
yarn-error.log
pnpm-debug.log
.vite/
.next/

# Local ComfyUI installs, outputs, models and experiments
/ComfyUI/
/comfyui/
/output/
/outputs/
/models/
/checkpoints/
/loras/
/vae/
/workflows_local/
/workflow_tests/
/experimental_workflows/
extra_model_paths.yaml

# User data and generated databases; bundle the source CSV and metadata instead
/wildcards/
/wildcards_config.json
/wildcards_config.example.json
/user/
/user_data/
/.prompt_palette/
/autocomplete.txt
/prompt_library_local/
/dev_library/
/local_palettes/
/exports/
/exports_tmp/
/thumbnails_generated/
/generated_thumbnails/
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.sqlite.tmp
*.sqlite3.tmp

# Private environment, editor and agent files
.env
.env.*
.vscode/
.idea/
.codex/
.claude/
.agents/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo

# Logs, temporary files and release packages
*.log
logs/
*.tmp
*.temp
*.bak
*.old
*.orig
~$*
/release/
/releases/
/packages/
/artifacts/
/deliverables/
*.zip
*.7z
*.rar
*.tar
*.tar.*
*.tgz
*.gz

# macOS / Windows metadata
.DS_Store
__MACOSX/
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.VolumeIcon.icns
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Internal release records and supplied agent mirrors stay separate from distribution.
/RELEASE_AUDIT_*.md
/RELEASE_CHANGES_*.md
/GITHUB_DESKTOP_COMMIT_*.txt
