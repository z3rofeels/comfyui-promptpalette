# Keep consistent line endings across platforms
* text=auto

# Source files
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
# Preserve dataset bytes: bundled metadata hashes the original CSV, including CRLF.
*.csv -text

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.zip binary
*.7z binary
*.safetensors binary

# Keep development-only notes out of source releases.
# Release controls and publishing automation remain in GitHub source archives.
/tests export-ignore
/AGENTS.md export-ignore
/CLAUDE.md export-ignore
/AUDIT.md export-ignore
/RELEASE_NOTES.md export-ignore
/STYLE_LIBRARY_IMPLEMENTATION.md export-ignore
/ERENODES_COMPARISON.md export-ignore
*HANDOFF*.md export-ignore
*Handoff*.md export-ignore
*handoff*.md export-ignore

/RELEASE_AUDIT_*.md export-ignore
/RELEASE_CHANGES_*.md export-ignore
/GITHUB_DESKTOP_COMMIT_*.txt export-ignore
/AGENTSpp.md export-ignore
